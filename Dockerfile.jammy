FROM ubuntu:22.04

WORKDIR /workspace
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y \
    build-essential \
    make \
    gcc \
    g++ \
    gdb \
    clang \
    valgrind \
    git \
    jq \
    libssl-dev \
    zlib1g-dev \
    autoconf \
    automake \
    libtool \
    cmake \
    curl \
    libblocksruntime-dev

COPY .install /workspace/.install

# Install Redis (SANITIZER can be 'address' for ASAN builds)
ARG SANITIZER=

COPY redis-src /workspace/redis
RUN chmod +x .install/install_redis.sh && \
    SANITIZER=${SANITIZER} .install/install_redis.sh
ENV LD_LIBRARY_PATH=/usr/local/lib

# Install uv and Python environment
RUN curl -LsSf https://astral.sh/uv/install.sh | env UV_INSTALL_DIR="/usr/local/bin" sh
ENV PATH="/usr/local/bin:${PATH}"
RUN uv venv --python=3.11 /opt/.venv
ENV VIRTUAL_ENV=/opt/.venv
ENV PATH="/opt/.venv/bin:${PATH}"
COPY requirements_docker.txt /workspace/requirements.txt
RUN uv pip install -r requirements.txt
